#!/usr/bin/env bash

set -u

if command -v betterlockscreen >/dev/null 2>&1; then
  exec betterlockscreen -l
fi

if command -v xsecurelock >/dev/null 2>&1; then
  exec xsecurelock
fi

if command -v i3lock >/dev/null 2>&1; then
  exec i3lock --color 282a36
fi

if command -v slock >/dev/null 2>&1; then
  exec slock
fi

if command -v loginctl >/dev/null 2>&1; then
  if [ -n "${XDG_SESSION_ID:-}" ]; then
    exec loginctl lock-session "$XDG_SESSION_ID"
  fi
  exec loginctl lock-session
fi

printf 'No supported screen locker is installed.\n' >&2
exit 127
