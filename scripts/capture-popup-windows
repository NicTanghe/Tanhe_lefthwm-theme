#!/usr/bin/env bash

set -euo pipefail

delay="${1:-4}"
out="${2:-/tmp/popup-windows.txt}"

echo "Open the tray menu now. Capturing window tree in ${delay}s..."
sleep "$delay"

mapfile -t window_ids < <(
  xwininfo -root -tree |
    sed -n 's/^ *\(0x[0-9a-fA-F]\+\).*/\1/p' |
    sort -u
)

{
  date
  echo
  echo "== xwininfo tree =="
  xwininfo -root -tree
  echo
  echo "== xprop for visible windows =="

  for id in "${window_ids[@]}"; do
    echo
    echo "---- $id ----"
    xprop -id "$id" \
      WM_NAME \
      WM_CLASS \
      WM_WINDOW_ROLE \
      _NET_WM_WINDOW_TYPE \
      _NET_WM_STATE \
      _GTK_FRAME_EXTENTS \
      2>&1 || true
  done
} > "$out"

echo "Wrote $out"
