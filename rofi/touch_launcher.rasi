/*******************************************************************************
 * MACOS LAUNCHPAD LIKE THEME FOR ROFI 
 * User                 : LR-Tech               
 * Theme Repo           : https://github.com/lr-tech/rofi-themes-collection
 *******************************************************************************/

configuration {
    modi: "drun";
    display-drun: "Applications";
    show-icons: true;
    icon-theme: "Yaru";
}

* {
    font: "CaskaydiaCove Nerd Font Propo SemiBold 10";

    bg0:  #24242480;
    bg1:  #2d2536;
    bg2:  #30273acc;
    bg3:  #9b6a90cc;
    bg4:  #6272a4e6;

    fg0:  #eadff0;
    fg1:  #b7a6bf;
    fg2:  #ffb86c;

    background-color: transparent;
    text-color:       @fg0;
    padding:          0px;
    margin:           0px;
}

window {
  fullscreen: true;
  padding: 1em;
  background-color: @bg0;
}

mainbox {
  padding:  8px;
}

inputbar {
  background-color: @bg2;

  margin:   0px calc( 50% - 120px );
  padding:  2px 4px;
  spacing:  4px;

  border:         1px;
  border-radius:  2px;
  border-color:   @bg3;

  children: [entry];
}

prompt {
  enabled:  false;
}

entry {
  text-color:          @fg2;
  placeholder:        "Search";
  placeholder-color:  @fg1;
  cursor-color:       @fg2;
  cursor-width:       2px;
  hide-cursor-on-empty: true;
}

listview {
  margin:   48px calc( 50% - 560px );
  spacing:  48px;
  columns:  6;
  fixed-columns: true;
}

element, element-text, element-icon {
  cursor: pointer;
}

element {
  padding:      8px;
  spacing:      4px;

  orientation:    vertical;
  border-radius:  16px;
}

element selected {
  background-color: @bg4;
  text-color: @fg2;
}

element-icon {
  size: 4em;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;
}
