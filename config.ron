// A WindowManager for Adventurers                         (____/
// For info about configuration please visit https://github.com/leftwm/leftwm/wiki

#![enable(implicit_some)]
(
    modkey: "Mod4",
    mousekey: "Mod4",
    workspaces: [
        ( output: "DP-0", x: 0, y: 0, height: 1440, width: 2560 ),
        ( output: "DP-2", x: 2560, y: 0, height: 2160, width: 3840 ),
    ],
    tags: [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "9",
    ],
    max_window_width: None,
    layouts: [
        "MainAndVertStack",
        "MainAndHorizontalStack",
        "MainAndDeck",
        "GridHorizontal",
        "EvenHorizontal",
        "EvenVertical",
        "Fibonacci",
        "LeftMain",
        "CenterMain",
        "CenterMainBalanced",
        "CenterMainFluid",
        "Monocle",
        "RightWiderLeftStack",
        "LeftWiderRightStack",
    ],
    layout_mode: Workspace,
    insert_behavior: Bottom,
    scratchpad: [
        (name: "Alacritty", value: "alacritty --config-file $HOME/.config/leftwm/themes/current/alacritty/alacritty.toml", x: 860, y: 390, height: 300, width: 200),
    ],
    window_rules: [
        ( window_class: "Blender", spawn_floating:  true),
        ( window_class: "zenity", spawn_floating:  true),
        ( window_class: "UnrealEditor", spawn_floating:  true),
        ( window_class: "Steam", spawn_floating:  true),
        ( window_class: "Houdini FX", spawn_floating:  true),
        ( window_class: "flameshot", spawn_floating:  true),
        ( window_title: "Battle.net.*", spawn_floating: true),
    ],
    disable_current_tag_swap: false,
    disable_tile_drag: false,
    disable_window_snap: true,
    focus_behaviour: Sloppy,
    focus_new_windows: true,
    sloppy_mouse_follows_focus: true,
    keybind: [

        //costum
        //soundkeys
        (command: Execute, value: "$HOME/.config/leftwm/scripts/volume-step up", modifier: [], key: "XF86XK_AudioRaiseVolume"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/volume-step down", modifier: [], key: "XF86XK_AudioLowerVolume"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/media-playerctl play-pause", modifier: [], key: "XF86XK_AudioPlay"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/media-playerctl play-pause", modifier: [], key: "XF86XK_AudioPause"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/media-playerctl stop", modifier: [], key: "XF86XK_AudioStop"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/media-playerctl next", modifier: [], key: "XF86XK_AudioNext"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/media-playerctl previous", modifier: [], key: "XF86XK_AudioPrev"),

        (command: Execute, value: "$HOME/.config/leftwm/scripts/flameshot-snipping-tool", modifier: ["modkey", "Shift"], key: "s"),

        (command: Execute, value: "env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 GDK_BACKEND=x11 $HOME/.config/leftwm/themes/current/bin/eww-patched -c $HOME/.config/eww/eww-bar open --toggle bar0", modifier: ["modkey"], key: "b"),

        (command: Execute, value: "env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 GDK_BACKEND=x11 MOZ_GTK_TITLEBAR_DECORATION=client firefox", modifier: ["modkey"], key: "i"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/file-manager", modifier: ["modkey"], key: "e"),

        (command: Execute, value: "$HOME/.config/leftwm/scripts/rofi-launcher", modifier: ["modkey"], key: "r"),

        (command: ToggleFullScreen, value: "", modifier: ["modkey", "Shift"], key: "f"),

        //edited
        (command: Execute, value: "rofi -no-config -no-lazy-grab -show drun -theme $HOME/.config/leftwm/themes/current/rofi/touch_launcher.rasi", modifier: ["modkey"], key: "p"),

        (command: Execute, value: "alacritty --config-file $HOME/.config/leftwm/themes/current/alacritty/alacritty.toml", modifier: ["modkey"], key: "Return"),
        (command: MoveWindowTop, value: "", modifier: ["modkey", "Shift"], key: "Return"),
        (command: CloseWindow, value: "", modifier: ["modkey"], key: "q"),




        //standard
//        (command: Execute, value: "dmenu_run", modifier: ["modkey"], key: "p"),
//        (command: Execute, value: "alacritty", modifier: ["modkey", "Shift"], key: "Return"),
//        (command: CloseWindow, value: "", modifier: ["modkey", "Shift"], key: "q"),
        (command: SoftReload, value: "", modifier: ["modkey", "Shift"], key: "r"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/logout-session", modifier: ["modkey", "Shift"], key: "x"),
        (command: Execute, value: "$HOME/.config/leftwm/scripts/lock-session", modifier: ["modkey", "Control"], key: "l"),
        (command: MoveToLastWorkspace, value: "", modifier: ["modkey", "Shift"], key: "w"),
        (command: SwapTags, value: "", modifier: ["modkey"], key: "w"),
        (command: MoveWindowUp, value: "", modifier: ["modkey", "Shift"], key: "k"),
        (command: MoveWindowDown, value: "", modifier: ["modkey", "Shift"], key: "j"),
//        (command: MoveWindowTop, value: "", modifier: ["modkey"], key: "Return"),
        (command: FocusWindowUp, value: "", modifier: ["modkey"], key: "k"),
        (command: FocusWindowDown, value: "", modifier: ["modkey"], key: "j"),
        (command: NextLayout, value: "", modifier: ["modkey", "Control"], key: "k"),
        (command: PreviousLayout, value: "", modifier: ["modkey", "Control"], key: "j"),
        (command: FocusWorkspaceNext, value: "", modifier: ["modkey"], key: "l"),
        (command: FocusWorkspacePrevious, value: "", modifier: ["modkey"], key: "h"),
        (command: MoveWindowUp, value: "", modifier: ["modkey", "Shift"], key: "Up"),
        (command: MoveWindowDown, value: "", modifier: ["modkey", "Shift"], key: "Down"),
        (command: FocusWindowUp, value: "", modifier: ["modkey"], key: "Up"),
        (command: FocusWindowDown, value: "", modifier: ["modkey"], key: "Down"),
        (command: NextLayout, value: "", modifier: ["modkey", "Control"], key: "Up"),
        (command: PreviousLayout, value: "", modifier: ["modkey", "Control"], key: "Down"),
        (command: FocusWorkspaceNext, value: "", modifier: ["modkey"], key: "Right"),
        (command: FocusWorkspacePrevious, value: "", modifier: ["modkey"], key: "Left"),
        (command: GotoTag, value: "1", modifier: ["modkey"], key: "1"),
        (command: GotoTag, value: "2", modifier: ["modkey"], key: "2"),
        (command: GotoTag, value: "3", modifier: ["modkey"], key: "3"),
        (command: GotoTag, value: "4", modifier: ["modkey"], key: "4"),
        (command: GotoTag, value: "5", modifier: ["modkey"], key: "5"),
        (command: GotoTag, value: "6", modifier: ["modkey"], key: "6"),
        (command: GotoTag, value: "7", modifier: ["modkey"], key: "7"),
        (command: GotoTag, value: "8", modifier: ["modkey"], key: "8"),
        (command: GotoTag, value: "9", modifier: ["modkey"], key: "9"),
        (command: MoveToTag, value: "1", modifier: ["modkey", "Shift"], key: "1"),
        (command: MoveToTag, value: "2", modifier: ["modkey", "Shift"], key: "2"),
        (command: MoveToTag, value: "3", modifier: ["modkey", "Shift"], key: "3"),
        (command: MoveToTag, value: "4", modifier: ["modkey", "Shift"], key: "4"),
        (command: MoveToTag, value: "5", modifier: ["modkey", "Shift"], key: "5"),
        (command: MoveToTag, value: "6", modifier: ["modkey", "Shift"], key: "6"),
        (command: MoveToTag, value: "7", modifier: ["modkey", "Shift"], key: "7"),
        (command: MoveToTag, value: "8", modifier: ["modkey", "Shift"], key: "8"),
        (command: MoveToTag, value: "9", modifier: ["modkey", "Shift"], key: "9"),
    ],
    state_path: None,
)
